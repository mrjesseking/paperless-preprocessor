# Sanitized example. Copy to .env and edit. Never commit a real .env.
# Defaults shown are the script's built-in defaults.
# Keep comments on their own lines: plain `docker --env-file` does not strip inline comments.

# Directories INSIDE the container (map host folders to these in compose)
INCOMING_DIR=/nas/incoming
OUT_DIR=/nas/consume
WORK_DIR=/nas/work

# Ollama: where page images and selected OCR text are sent.
# Use an address reachable FROM the container.
OLLAMA_URL=http://ollama.example.lan:11434
# Must be the exact tag installed on YOUR Ollama server: vision-capable, with structured-output support.
OLLAMA_MODEL=gemma4:latest
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=600

# Pipeline behavior
STABLE_SECONDS=20
POLL_SECONDS=5
# MAX_PAGES = pages sent to the vision model. OCR still covers the whole PDF.
MAX_PAGES=4
RENDER_DPI=150
OCR_LANG=eng
OCR_JOBS=3
# OCR_THREADS defaults to OCR_JOBS when unset.
# OCR_THREADS=3
JOBID_PREFIX=1
CLEANUP_WORKDIR=1
